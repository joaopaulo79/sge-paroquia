<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="300" minHeight="-Infinity" minWidth="150" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label text="Fundo Inicial" />
      <Spinner fx:id="spinnerFundoInicial" editable="true" />
      <Button fx:id="btnAbrirCaixa" mnemonicParsing="false" onAction="#abrirCaixa" text="Abrir Caixa" />
   </children>
</VBox>
