<?import javafx.scene.text.Font?>

<BorderPane id="rootPane" fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" style="-fx-background-color: #FF00FF;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.paroquiaTeam.sgeParoquia.controller.BaseController">
   <left>
      <VBox id="sideBar" fx:id="sideBar" managed="false" minWidth="64.0" prefWidth="64.0" style="-fx-background-color: #888888;" visible="false" BorderPane.alignment="CENTER">
         <children>
          	<ToggleButton fx:id="btnNavDashboard" minWidth="48.0" mnemonicParsing="false" text="Dashboard" userData="" wrapText="true" />
			<ToggleButton fx:id="btnNavConvenios" minWidth="48.0" mnemonicParsing="false" text="Convênios" userData="" wrapText="true" />
			<ToggleButton fx:id="btnNavClientes" minWidth="48.0" mnemonicParsing="false" text="Clientes" userData="" wrapText="true" />
			<ToggleButton fx:id="btnNavVeiculos" minWidth="48.0" mnemonicParsing="false" text="Veículos" userData="" wrapText="true" />
            <ToggleButton fx:id="btnNavVagas" minWidth="48.0" mnemonicParsing="false" text="Vagas" userData="" wrapText="true" />
            <ToggleButton fx:id="btnNavConfig" minWidth="48.0" mnemonicParsing="false" text="Config" userData="" wrapText="true" />
			<ToggleButton fx:id="btnNavCaixas" minWidth="48.0" mnemonicParsing="false" text="Caixas" userData="" wrapText="true" />
			<ToggleButton fx:id="btnNavUsuarios" minWidth="48.0" mnemonicParsing="false" text="Usuários" userData="" wrapText="true" />
         </children></VBox>
   </left>
   <center>
      <AnchorPane id="contentArea" fx:id="contentArea" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </center>
   <top>
      <BorderPane fx:id="topBar" maxHeight="75.0" minHeight="75.0" prefHeight="75.0" style="-fx-background-color: #000000;" BorderPane.alignment="CENTER">
