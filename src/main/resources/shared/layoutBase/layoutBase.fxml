            <Label fx:id="labelTitulo" alignment="CENTER" contentDisplay="CENTER" text="Tela" BorderPane.alignment="CENTER" />
         </center>
         <right>
            <HBox fx:id="hBoxUsuario" alignment="CENTER" prefHeight="75.0" visible="false" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="labelUsuario" text="Usuário" />
                  <StackPane prefHeight="150.0" prefWidth="200.0">
                     <children>
                        <Circle fill="#dd5c00" radius="30.0" stroke="BLACK" strokeType="INSIDE" />
                        <Label fx:id="labelLetraUsuario" text="U" textFill="WHITE">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                     </children>
                  </StackPane>
               </children>
            </HBox>
         </right>
      </BorderPane>
   </top>
