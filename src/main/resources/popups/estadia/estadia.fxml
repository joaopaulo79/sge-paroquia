<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" stylesheets="/shared/styles/card.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <content>
      <VBox prefHeight="200.0" prefWidth="598.0">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox fx:id="containerCards" prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS" />
                  <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox fx:id="containerTicket" prefHeight="200.0" prefWidth="100.0" VBox.vgrow="ALWAYS">
                           <children>
                              <Label text="Preview do Ticket" wrapText="true" />
                              <TextArea fx:id="areaTicket" editable="false" prefHeight="200.0" prefWidth="200.0" wrapText="true" VBox.vgrow="ALWAYS" />
                              <Label text="Esta é apenas uma pré-visualização. O ticket impresso pode variar em fonte, largura das linhas, acentos e corte, dependendo da impressora e do papel utilizados." wrapText="true">
                                 <font>
                                    <Font name="System Italic" size="10.0" />
                                 </font>
                              </Label>
                           </children></VBox>
                        <CheckBox fx:id="checkAdiantarDiaria" mnemonicParsing="false" text="Adiantar Diária" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox fillHeight="false" prefWidth="200.0" VBox.vgrow="NEVER">
               <children>
                  <Button fx:id="btnCancelar" mnemonicParsing="false" text="Cancelar" />
                  <Button fx:id="btnConfirmar" alignment="CENTER_RIGHT" mnemonicParsing="false" text="Confirmar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
