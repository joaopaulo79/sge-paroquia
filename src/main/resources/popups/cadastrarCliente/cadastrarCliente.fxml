<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox prefHeight="200.0">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="CPF" />
                  <TextField fx:id="textFieldCpf" />
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Nome" />
                  <TextField fx:id="textFieldNome" />
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Telefone" />
                  <TextField fx:id="textFieldTelefone" />
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Tipo" />
                  <ChoiceBox fx:id="choiceTipo" prefWidth="150.0" />
               </children>
            </VBox>
            <VBox fx:id="campoDadosMensalista" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Label text="Data de Vencimento" />
                        <DatePicker fx:id="pickerDataVencimento" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Label text="Mensalidade" />
                        <Spinner fx:id="spinnerMensalidade" />
                     </children>
                  </VBox>
               </children></VBox>
            <VBox fx:id="campoDadosConveniado" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <VBox fx:id="vBoxDadosConvenio" prefHeight="200.0" prefWidth="100.0" />
                  <Button fx:id="btnSelecionarConvenio" mnemonicParsing="false" text="Selecionar" />
               </children>
            </VBox>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button fx:id="btnCancelar" mnemonicParsing="false" text="Cancelar" />
                  <Button fx:id="btnSalvar" mnemonicParsing="false" text="Salvar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
