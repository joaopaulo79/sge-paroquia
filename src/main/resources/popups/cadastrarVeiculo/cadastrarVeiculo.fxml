<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox prefHeight="200.0">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Placa" />
                  <TextField fx:id="textFieldPlaca" />
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Marca" />
                  <TextField fx:id="textFieldMarca" />
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Modelo" />
                  <TextField fx:id="textFieldModelo" />
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Ano" />
                  <Spinner fx:id="spinnerAno" />
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Cor" />
                  <TextField fx:id="textFieldCor" />
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Observações (opcional)" />
                  <TextArea fx:id="textAreaObservacoes" prefHeight="200.0" prefWidth="200.0" />
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Tipo de Veículo" />
                  <RadioButton fx:id="radioCarro" mnemonicParsing="false" text="Carro">
                     <toggleGroup>
                        <ToggleGroup fx:id="grupoTipoVeiculo" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton fx:id="radioMoto" mnemonicParsing="false" text="Moto" toggleGroup="$grupoTipoVeiculo" />
               </children>
            </VBox>
            <VBox layoutX="10.0" layoutY="342.0" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <VBox fx:id="vBoxDadosCliente" prefHeight="200.0" prefWidth="100.0" />
                  <Button fx:id="btnSelecionarCliente" mnemonicParsing="false" text="Selecionar Cliente" />
               </children>
            </VBox>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button fx:id="btnCancelar" mnemonicParsing="false" text="Cancelar" />
                  <Button fx:id="btnSalvar" mnemonicParsing="false" text="Salvar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
