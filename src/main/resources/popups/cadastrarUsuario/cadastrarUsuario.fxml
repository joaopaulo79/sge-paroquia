<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox prefHeight="200.0">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Nome" />
                  <TextField fx:id="textFieldNome" />
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Login" />
                  <TextField fx:id="textFieldLogin" />
               </children>
            </VBox>
            <VBox fx:id="vBoxCamposSenha" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Label text="Senha" />
                        <TextField fx:id="textFieldSenha" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Label text="Repita Senha" />
                        <TextField fx:id="textFieldSenhaRepetida" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Tipo" />
                  <RadioButton fx:id="radioOperador" mnemonicParsing="false" selected="true" text="Operador">
                     <toggleGroup>
                        <ToggleGroup fx:id="grupoTipoUsuario" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton fx:id="radioAdministrador" mnemonicParsing="false" text="Administrador" toggleGroup="$grupoTipoUsuario" />
               </children>
            </VBox>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button fx:id="btnCancelar" mnemonicParsing="false" text="Cancelar" />
                  <Button fx:id="btnSalvar" mnemonicParsing="false" text="Salvar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
