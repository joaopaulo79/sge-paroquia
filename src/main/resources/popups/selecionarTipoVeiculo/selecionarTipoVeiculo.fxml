<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox fx:id="container">
         <children>
            <Label text="Selecione o tipo de veículo" />
            <HBox VBox.vgrow="ALWAYS">
               <children>
                  <Button mnemonicParsing="false" onAction="#selecionarCarro" text="Carro" />
                  <Button mnemonicParsing="false" onAction="#selecionarMoto" text="Moto" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
